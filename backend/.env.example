# Copy to .env and adjust. Postgres is the real target; the SQLite default
# in app/config.py only exists so the app runs with zero setup.
DATABASE_URL=postgresql+psycopg2://smartpack:smartpack@localhost:5432/smartpack

# Comma-separated origins, or "*" for the standalone smartpack.html demo.
CORS_ORIGINS=*

# Minimum real (user-reported) feedback rows before the ML shelf-life model
# trains and starts returning mlPredictedShelfLifeDays at all.
SMARTPACK_ML_MIN_ROWS=25

# Minimum seconds between retrain attempts.
SMARTPACK_ML_RETRAIN_S=300

SMARTPACK_ECHO_SQL=false
